# Placeholder values only — never commit real secrets.
# Copy to .env for local development: cp .env.example .env

PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string (no real credentials here — placeholder only).
MONGODB_URI=your_mongodb_atlas_connection_string_here

# JWT auth (placeholders only — generate your own long random secret locally).
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Initial OWNER seeding only (placeholders only — never commit real values).
# Used by: ADMIN_EMAIL=you@example.com ADMIN_PASSWORD=<secret> npm run seed:owner
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=replace_with_a_strong_password
# Optional display name for the seeded owner.
ADMIN_NAME=Owner

# CORS allowlist, comma-separated (no real domains here — placeholders only).
# Empty preserves open development behavior. In production, set your real
# frontend origin(s), e.g. CORS_ORIGINS=https://app.example.com
CORS_ORIGINS=

# Authentication rate limiting (POST /api/auth/login and /api/auth/register).
# Defaults are development-friendly. In production use a lower limit such as
# 10-20 requests per 15 minutes: AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=100
